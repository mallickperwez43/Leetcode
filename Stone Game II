class Solution {
public:
    int n;
    int dp[2][101][101];  // t[2][n+1][n+1]  // TC : O(n^2) * n ~ O(n^3)

    int solveForAlice(vector<int>& piles, int person, int i, int M){
        if(i >= n)
            return 0;

        if(dp[person][i][M] != -1)
            return dp[person][i][M];    
        
        int result = (person == 1) ? -1 : INT_MAX;

        int stones = 0;

        // check for all ranges(possible)   O(n)
        for(int x = 1; x <= min(2 * M, n - i); x++){
            stones += piles[i + x - 1];

            if(person == 1){ // Alice -> maximize
                result = max(result, stones + solveForAlice(piles, 0, i + x, max(M, x)));
            }
            else{ // Bob -> Minimize for Alice
                result = min(result, solveForAlice(piles, 1, i + x, max(M, x)));
            }
        }

        return dp[person][i][M] = result;
    }

    int stoneGameII(vector<int>& piles) {
        n = piles.size();

        memset(dp, -1, sizeof(dp));

        // 1 -> Alice
        // 0 -> Bob 
        return solveForAlice(piles, 1, 0, 1);
    }
};
