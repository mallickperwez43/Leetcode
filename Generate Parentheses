// Appraoch - 1

class Solution {
public:
    vector<string> result;
    
    bool isValid(string& str) {
        int count = 0;
        for(char& ch : str) {
            if(ch == '(') {
                count++;
            }
            else {
                count--;
            }

            if(count < 0) {
                return false;
            }
        }

        return count == 0;
    }
      
    void solve(string& cur, int n) {
        // base case
        if(cur.length() == 2 * n) {
            if(isValid(cur)) {
                result.push_back(cur);
            }
            return;
        }
        
        // for '('
        cur.push_back('('); // Do
        solve(cur, n);      // Explore
        cur.pop_back();     // Undo
        
        // for ')'
        cur.push_back(')'); // Do
        solve(cur, n);      // Explore
        cur.pop_back();     // Undo
    }

    vector<string> generateParenthesis(int n) {
        string cur = "";

        solve(cur, n);

        return result;  
    }
};

// TC : O(2 ^ 2n * 2n);
// SC : O(2n);


// Approach - 2

class Solution {
public:
    vector<string> result;
      
    void solve(string& cur, int n, int open, int close) {
        // base case
        if(cur.length() == 2 * n) {
            result.push_back(cur);
            return;
        }
        
        if(open < n) {
            cur.push_back('(');             // Do
            solve(cur, n, open + 1, close); // Explore
            cur.pop_back();                 // Undo
        }
        
        if(close < open) {
            cur.push_back(')');             // Do
            solve(cur, n, open, close + 1); // Explore
            cur.pop_back();                 // Undo
        }
    }

    vector<string> generateParenthesis(int n) {
        string cur = "";
        
        int open  = 0;
        int close = 0;

        solve(cur, n, open, close);

        return result;  
    }
};

// TC : O(2 ^ 2n * 2n);
// SC : O(2n);
