class Solution {
public:
    vector<string> result;
    
    bool isValid(string& str) {
        int count = 0;
        for(char& ch : str) {
            if(ch == '(') {
                count++;
            }
            else {
                count--;
            }

            if(count < 0) {
                return false;
            }
        }

        return count == 0;
    }
      
    void solve(string& cur, int n) {
        // base case
        if(cur.length() == 2 * n) {
            if(isValid(cur)) {
                result.push_back(cur);
            }
            return;
        }
        
        // for '('
        cur.push_back('('); // Do
        solve(cur, n);      // Explore
        cur.pop_back();     // Undo
        
        // for ')'
        cur.push_back(')'); // Do
        solve(cur, n);      // Explore
        cur.pop_back();     // Undo
    }

    vector<string> generateParenthesis(int n) {
        string cur = "";

        solve(cur, n);

        return result;  
    }
};

// TC : O(2 ^ 2n * 2n);
// SC : O(2n);


