class Solution {
public:
    char midChar = '$';
    int halfLen = 0;
    string result = "";

    bool solve(string& curr, vector<int>& count, string& target, int i, bool greater) {
        if(curr.length() == halfLen) {
            string candidate = curr; // leftHalf
            string rightHalf = curr; 
            reverse(rightHalf.begin(), rightHalf.end());

            if(midChar != '$') {
                candidate += midChar;
            }

            candidate += rightHalf;

            if(candidate > target) {
                result = candidate;
                return true;
            }

            return false;
        }

        for(char ch = 'a'; ch <= 'z'; ch++) {
            if(!count[ch - 'a']) continue;

            if(!greater && ch < target[i]) continue;

            // DO
            curr.push_back(ch);
            count[ch - 'a']--;

            // EXPLORE
            bool isGreater = greater || ch > target[i];
            if(solve(curr, count, target, i + 1, isGreater)) {
                return true;
            }

            // UNDO
            curr.pop_back();
            count[ch - 'a']++;
        }

        return false;
    }

    string lexPalindromicPermutation(string s, string target) {
        int n = s.length();

        vector<int> count(26, 0);
        for(char& ch : s) {
            count[ch - 'a']++;
        }

        int oddCount = 0; // count of characters with odd frequency
        for(int ch = 0; ch < 26; ch++) {
            if(count[ch] & 1) {
                oddCount++;
                midChar = ch + 'a';
            }
        }

        if(oddCount > 1) {
            return ""; // not possible to make palindrome
        }
        
        // for left half of palindrome
        for(int ch = 0; ch < 26; ch++) {
            count[ch] /= 2;
        }

        halfLen = n / 2;

        string curr; // left half
        solve(curr, count, target, 0, false);

        return result;
    }
};
