// Approach 1

class Solution {
public:
    int minimumPushes(string word) {
        int result = 0;

        vector<int> mp(10, 0);

        int assign_key = 2;

        for(char& ch : word) {
            if(assign_key > 9) {
                assign_key = 2;
            }

            mp[assign_key]++;

            result += mp[assign_key];

            assign_key++;
        }

        return result;
    }
};


// Approach 2

class Solution {
public:
    int minimumPushes(string word) {
        vector<int> mp(26, 0);

        for(char& ch : word) {
            mp[ch - 'a']++;
        }

        sort(mp.begin(), mp.end(), greater<int>());

        int result = 0;

        for(int i = 0; i < 26; i++) {
            int freq = mp[i];

            if(freq == 0) {
                break;
            }

            int press = (i / 8) + 1;

            result += (press * freq);
        }

        return result;
    }
};
