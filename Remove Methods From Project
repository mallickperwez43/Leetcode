class Solution {
public:
    vector<int> remainingMethods(int n, int k, vector<vector<int>>& invocations) {
        
        // Adj list and indegree array
        vector<vector<int>> adj(n);
        vector<int> indegree(n, 0);
        vector<bool> suspicious(n, false);

        for(auto& edge : invocations) {
            int u = edge[0];
            int v = edge[1];

            adj[u].push_back(v);
            indegree[v]++;
        }

        // BFS/DFS
        queue<int> que;
        que.push(k);
        suspicious[k] = true;
        
        while(!que.empty()) {
            int curr = que.front();
            que.pop();

            for(int& ngbr : adj[curr]) {
                indegree[ngbr]--;
                if(!suspicious[ngbr]) {
                    que.push(ngbr);
                    suspicious[ngbr] = true;
                }
            }
        }

        // result
        vector<int> result;
        bool cannotRemove = false;
        for(int i = 0; i < n; i++) {
            if(suspicious[i] && indegree[i] > 0) {
                // we cannot remove anything just return 0, 1, 2, ...n - 1
                cannotRemove = true;
                break;
            }

            if(!suspicious[i]) {
                result.push_back(i);
            }
        }

        if(cannotRemove) {
            vector<int> vec(n);
            for(int i = 0; i < n; i++) {
                vec[i] = i;
            }

            return vec;
        }

        return result;
    }   
};
