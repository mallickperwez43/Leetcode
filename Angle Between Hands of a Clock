// Method 1

class Solution {
public:
    double angleClock(int hour, int minutes) {
        // considering 00, 12 as reference point
        double minuteAngle = minutes * 6; // in degrees

        double hourAlone = (hour % 12) * 30;
        double minuteDeviationInHour = minutes * 0.5;

        double hourAngle = hourAlone + minuteDeviationInHour;

        double angle_1 = abs(hourAngle - minuteAngle);
        double angle_2 = 360 - angle_1;

        return min(angle_1, angle_2);
    };
};


// Method 2

class Solution {
public:
    double angleClock(int hour, int minutes) {
        double total_hour = double(hour) + double(minutes)/60;
        
        //12 hr -> 360 degrees
        //1 hr  -> 30 degress
        //x hr  -> x*30;
        double angle_hour_hand = total_hour*30;
        
        //60 min -> 360 degrees
        //1 min  -> 6 degrees
        //y min  -> y*6
        
        double angle_minute_hand = minutes*6;
        
        double result = abs(angle_minute_hand - angle_hour_hand);
        
        if(result > 180)
            return 360-result;
        return result;
    };
};
