// Approach 1 : Stack based

class Solution {
public:
    int longestValidParentheses(string s) {
        stack<int> st; // indexes
        st.push(-1); // base of ( unpaired parantheses
        int result = 0;

        for(int i = 0; i < s.length(); i++){
            if(s[i] == '('){
                st.push(i);
            }
            else{
                st.pop(); // matched
                if(st.empty()){
                    st.push(i); // new base
                }
                else{
                    result = max(result, i - st.top());
                }
            }
        }

        return result;
    }
};


// Appraoch 2 : Simulating using open and close variables

class Solution {
public:
    int longestValidParentheses(string s) {
        int n = s.length();

        int open  = 0;
        int close = 0;

        // left to right
        int result = 0;

        for(int i = 0; i < n; i++) {
            if(s[i] == '(') open++;
            else close++;

            if(open == close) {
                result = max(result, open + close);
            }
            else if(close > open) {
                open = close = 0;
            }
        }

        // right to left
        open = close = 0;
        for(int i = n - 1; i >= 0; i--) {
            if(s[i] == '(') open++;
            else close++;

            if(open == close) {
                result = max(result, open + close);
            }
            else if(open > close) {
                open = close = 0;
            }
        }

        return result;
    }
};
