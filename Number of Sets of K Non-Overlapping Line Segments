// Recursion + Memoization  ---- TLE

class Solution {
public:
    int M = 1e9 + 7;

    int solve(int n, int k, int i, vector<vector<int>>& dp) {
        if(k == 0) 
            return 1;
        
        if(i >= n)
            return 0;
        
        if(dp[k][i] != -1) 
            return dp[k][i];

        long long take = 0; // start point = i;
        for(int j = i + 1; j < n; j++) { // end point = j;
            take = (take + solve(n, k - 1, j, dp)) % M;
        }

        long long skip = solve(n, k, i + 1, dp) % M;

        return dp[k][i] = (take + skip) % M;
    }

    int numberOfSets(int n, int k) {
        vector<vector<int>> dp(k + 1, vector<int>(n + 1, -1));
        return solve(n, k, 0, dp) % M;    
    }
};


// Bottom Up  ---- TLE

class Solution {
public:
    int M = 1e9 + 7;

    int numberOfSets(int n, int K) {
        
        vector<vector<int>> dp(K + 1, vector<int>(n + 1, 0));

        for (int i = 0; i <= n; i++) {
            dp[0][i] = (i < n) ? 1 : 0;
        }

        for (int k = 1; k <= K; k++) {

            for (int i = n - 1; i >= 0; i--) {
                
                int skip = dp[k][i + 1];

                int take = 0;
                for (int j = i + 1; j < n; j++) {
                    take = (take + dp[k - 1][j]) % M;
                }

                dp[k][i] = (take + skip) % M;
            }
        }

        return dp[K][0];
   
    }
};


// Improved Bottom Up

class Solution {
public:
    int M = 1e9 + 7;

    int numberOfSets(int n, int K) {
        
        vector<vector<int>> dp(K + 1, vector<int>(n + 1, 0));

        for (int i = 0; i <= n; i++) {
            dp[0][i] = (i < n) ? 1 : 0;
        }

        for (int k = 1; k <= K; k++) {
            
            vector<int> prevRowSum(n + 1, 0);
            for(int x = n - 1; x >= 0; x--) {
                prevRowSum[x] = (prevRowSum[x + 1] + dp[k - 1][x]) % M;
            }

            for (int i = n - 1; i >= 0; i--) {
                
                int skip = dp[k][i + 1] % M;

                int take = prevRowSum[i + 1] % M;

                dp[k][i] = (take + skip) % M;
            }
        }

        return dp[K][0];
   
    }
};
