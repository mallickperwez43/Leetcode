class Solution {
public:
    string smallestSubsequence(string s) {
        int n = s.length();

        string result;

        vector<bool> taken(26, false);
        vector<int> lastOcc(26);

        for(int i = 0; i < n; i++) {
            char ch = s[i];

            lastOcc[ch - 'a'] = i;
        }

        for(int i = 0; i < n; i++) {
            char ch = s[i];

            int idx = ch - 'a';

            if(taken[idx]) continue;

            while(!result.empty() && result.back() > ch && lastOcc[result.back() - 'a'] > i) {
                taken[result.back() - 'a'] = false;
                result.pop_back();
            }

            result.push_back(ch);
            taken[ch - 'a'] = true;
        }

        return result;
    }
};
