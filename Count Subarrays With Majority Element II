class Solution {
public:
    long long countMajoritySubarrays(vector<int>& nums, int target) {
        unordered_map<int, int> mp; // mp[cumSum] = count
        mp[0] = 1;

        long long cumSum = 0;

        long long validLeftPoints = 0;

        long long result = 0;

        for(int& num : nums) {
            if(num == target) {
                validLeftPoints += mp[cumSum]; // prev all valid
                cumSum += 1;
            }
            else {
                cumSum -= 1;
                validLeftPoints -= mp[cumSum]; // prev - 1 all valid
            }

            mp[cumSum] += 1;

            result += validLeftPoints;
        }

        return result;
    }
};
