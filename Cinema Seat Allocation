// Appraoch 1 : Using hashmap + hashset

class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        unordered_map<int, unordered_set<int>> mp; // row -> booked seats in that row

        for(auto& reservedSeat : reservedSeats) {
            int row  = reservedSeat[0];
            int seat = reservedSeat[1];

            mp[row].insert(seat);
        }

        int result = (n - mp.size()) * 2; // Empty rows -> Group A And Group C

        for(auto& [row, bookedSeats] : mp) {
            
            auto isAvailable = [&](int seat) {
                return bookedSeats.find(seat) == bookedSeats.end();
            };

            bool groupA = isAvailable(2) && isAvailable(3) && isAvailable(4) && isAvailable(5);
            bool groupB = isAvailable(4) && isAvailable(5) && isAvailable(6) && isAvailable(7);
            bool groupC = isAvailable(6) && isAvailable(7) && isAvailable(8) && isAvailable(9);

            if(groupA && groupC) {
                result += 2;
            }
            else if(groupA || groupB || groupC) {
                result += 1;
            }
        }

        return result;
    }
};


// Appraoch 2 : Using hashmap + bitmask(because a row has only fixed 10 seats);

class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        unordered_map<int, int> mp; // row -> mask of that row

        for(auto& reservedSeat : reservedSeats) {
            int row  = reservedSeat[0];
            int seat = reservedSeat[1];

            mp[row] |= (1 << seat); // building the mask
        }

        int result = (n - mp.size()) * 2; // Empty rows -> Group A And Group C

        int maskA = (1 << 2) | (1 << 3) | (1 << 4) | (1 << 5);
        int maskB = (1 << 4) | (1 << 5) | (1 << 6) | (1 << 7);
        int maskC = (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9);

        for(auto& [row, bookedSeatsMask] : mp) {

            bool groupA = (bookedSeatsMask & maskA) == 0;
            bool groupB = (bookedSeatsMask & maskB) == 0;
            bool groupC = (bookedSeatsMask & maskC) == 0;

            if(groupA && groupC) {
                result += 2;
            }
            else if(groupA || groupB || groupC) {
                result += 1;
            }
        }

        return result;
    }
};
