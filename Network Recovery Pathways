class Solution {
public: 
    typedef long long ll;
    typedef pair<long long, int> P;

    bool check(int mid, int n, ll k, unordered_map<int, vector<pair<int, int>>>& adj) {
        vector<ll> result(n, LLONG_MAX);
        // result[i] = min cost path from src = 0 to ith node
        
        priority_queue<P, vector<P>, greater<P>> pq; // {cost, node}
        
        result[0] = 0;
        pq.push(make_pair(0, 0)); 

        while(!pq.empty()) {
            auto [cost, node] = pq.top();
            pq.pop();

            
            if(cost > k) { // skip this path as a not valid path
                return false;
            }

            if(node == n - 1) {
                return true;
            }

            if(result[node] < cost) {
                continue;
            }

            for(auto& edge : adj[node]) {
                int ngbr = edge.first;
                int cost_ngbr = edge.second;

                if(cost_ngbr < mid) {
                    continue;
                }

                if(cost + cost_ngbr < result[ngbr]) {
                    result[ngbr] = cost + cost_ngbr;

                    pq.push(make_pair(result[ngbr], ngbr));
                }
            }
        }

        return false;
    }

    int findMaxPathScore(vector<vector<int>>& edges, vector<bool>& online, long long k) {
        int n = online.size(); // total n nodes

        // adjacency list
        // u -> {{v, cost}, ...}
        unordered_map<int, vector<pair<int, int>>> adj;
        int minCost = INT_MAX;
        int maxCost = INT_MIN;
        bool hasValidEdges = false;
        for(auto& edge : edges) {
            int u    = edge[0];
            int v    = edge[1];
            int cost = edge[2];

            if(!online[u] || !online[v]) {
                continue;   
            }

            adj[u].push_back({v, cost});
            minCost = min(minCost, cost);
            maxCost = max(maxCost, cost);
            hasValidEdges = true;
        }

        if(!hasValidEdges) {
            return -1;
        }

        int result = -1;
        int l = minCost;
        int r = maxCost;

        while(l <= r) {
            int mid = l + (r - l) / 2; // mid score

            if(check(mid, n, k, adj)) {
                result = mid;
                l = mid + 1;
            }
            else {
                r = mid - 1;
            }
        }

        return result;
    }
};
