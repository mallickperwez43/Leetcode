// Appraoch 1

class Solution {
public:
    vector<vector<int>> directions = {{0, 1}, {0, -1}, {1, 0}, {-1, 0}};
    int maximumSafenessFactor(vector<vector<int>>& grid) {
        int n = grid.size();
        vector<vector<int>> dist(n, vector<int>(n, INT_MAX));
        queue<pair<int, int>> q;

        // Initialize all thief positions
        for (int r = 0; r < n; ++r) {
            for (int c = 0; c < n; ++c) {
                if (grid[r][c] == 1) {
                    q.push({r, c});
                    dist[r][c] = 0;
                }
            }
        }

        // Multi-source BFS to calculate minimum distance to any thief
        while (!q.empty()) {
            auto [r, c] = q.front();
            q.pop();
            for (auto& dir : directions) {
                int nr = r + dir[0], nc = c + dir[1];
                if (nr >= 0 && nr < n && nc >= 0 && nc < n && dist[nr][nc] == INT_MAX) {
                    dist[nr][nc] = dist[r][c] + 1;
                    q.push({nr, nc});
                }
            }
        }

        // Use priority queue to find path with maximum safeness factor
        priority_queue<pair<int, pair<int, int>>> pq;
        pq.push({dist[0][0], {0, 0}});
        vector<vector<int>> maxSafeness(n, vector<int>(n, -1));
        maxSafeness[0][0] = dist[0][0];

        while (!pq.empty()) {
            auto [d, pos] = pq.top();
            pq.pop();
            int r = pos.first, c = pos.second;
            if (r == n - 1 && c == n - 1) return d;  // Reached bottom-right corner

            for (auto& dir : directions) {
                int nr = r + dir[0], nc = c + dir[1];
                if (nr >= 0 && nr < n && nc >= 0 && nc < n) {
                    int newSafe = min(d, dist[nr][nc]);
                    if (newSafe > maxSafeness[nr][nc]) {
                        maxSafeness[nr][nc] = newSafe;
                        pq.push({newSafe, {nr, nc}});
                    }
                }
            }
        }

        return -1;  // In case there's no valid path
    }
};


// Appraoch 2

class Solution {
public:
    int n;

    vector<vector<int>> directions = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};

    bool check(int sf, vector<vector<int>>& distNearestThief) {
        if (distNearestThief[0][0] < sf) {
            return false;
        }

        queue<pair<int, int>> que;
        vector<vector<bool>> visited(n, vector<bool>(n, false));

        // src = [0][0]
        // dest = [n - 1][n - 1]

        que.push(make_pair(0, 0));
        visited[0][0] = true;


        auto isSafe = [&](int i, int j) {
            return (i >= 0 && i < n && j >= 0 && j < n && !visited[i][j] && distNearestThief[i][j] >= sf);
        };

        while(!que.empty()) {
            auto [i, j] = que.front();
            que.pop();

            if(i == n - 1 && j == n - 1) {
                return true;
            }

            for(auto& dir : directions) {
                int i_ = i + dir[0];
                int j_ = j + dir[1];

                if(!isSafe(i_, j_)) {
                    continue;
                }

                que.push(make_pair(i_, j_));
                visited[i_][j_] = true;
            }
        }

        return false;
    }

    int maximumSafenessFactor(vector<vector<int>>& grid) {
        n = grid.size();

        // EDGE CASE
        if (grid[0][0] == 1 || grid[n - 1][n - 1] == 1) {
            return 0;
        }

        // Step 1 : Precompute of distanceToNearestThief using MultiSource BFS
        vector<vector<int>> distNearestThief(n, vector<int>(n, -1));
        queue<pair<int,int>> que;
        vector<vector<bool>> visited(n, vector<bool>(n, false));


        // push all cells where there are thieves
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < n; j++) {
                if(grid[i][j]) {
                    que.push(make_pair(i, j));
                    visited[i][j] = true;
                    distNearestThief[i][j] = 0;
                }
            }
        }    

        auto isSafe = [&](int i, int j) {
            return (i >= 0 && i < n && j >= 0 && j < n && !visited[i][j]);
        };

        int level = 0;
        int maxSF = 0;
        while(!que.empty()) {
            int size = que.size();

            while(size--) {
                auto [i, j] = que.front();
                que.pop();

                distNearestThief[i][j] = level;
                maxSF = max(maxSF, level);

                for(auto& dir : directions) {
                    int i_ = i + dir[0];
                    int j_ = j + dir[1];

                    if(!isSafe(i_, j_)) {
                        continue;
                    }

                    que.push(make_pair(i_, j_));
                    visited[i_][j_] = true;
                }
            }

            level++;
        }

        // Step 2 : Apply Binary Search On Safeness Factor
        int l = 0;
        int r = maxSF;
        int result = 0;

        while(l <= r) {
            int mid_sf = l + (r - l) / 2;

            if(check(mid_sf, distNearestThief)) { // Step 3 : Write check function : A path with minSF >= mid_sf from [0][0] to [n - 1][n - 1]
                result = mid_sf;
                l = mid_sf + 1;
            }
            else {
                r = mid_sf - 1;
            }
        }

        return result;
    }
};

// TC : O(n ^ 2 * logn)
// SC : O(n * n)
