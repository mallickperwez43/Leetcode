// Appraoch 1 : Recursion + Memoization

class Solution {
public:
    int M = 1e9 + 7;
    int dp[201][201][201];

    int solve(int i, int gcd_1, int gcd_2, vector<int>& nums) {
        if(i == nums.size()) {
            bool bothNonEmpty = (gcd_1 != 0 && gcd_2 != 0);
            bool gcdMatches   = (gcd_1 == gcd_2);

            return (bothNonEmpty && gcdMatches) ? 1 : 0;
        }

        if(dp[i][gcd_1][gcd_2] != -1) {
            return dp[i][gcd_1][gcd_2];
        }

        // skip the element
        int skip = (solve(i + 1, gcd_1, gcd_2, nums)) % M;

        // take in subsequence 1
        int take_1 = (solve(i + 1, gcd(gcd_1, nums[i]), gcd_2, nums)) % M;
        
        // take in subsequence 2
        int take_2 = (solve(i + 1, gcd_1, gcd(gcd_2, nums[i]), nums)) % M;

        return dp[i][gcd_1][gcd_2] = (0LL + skip + take_1 + take_2) % M;
    }

    int subsequencePairCount(vector<int>& nums) {
        
        memset(dp, -1, sizeof(dp));

        return solve(0, 0, 0, nums);
    }
};


// Appraoch 2 : Bottom Up

class Solution {
public:
    int M = 1e9 + 7;

    int subsequencePairCount(vector<int>& nums) {
        int n = nums.size();
        int maxEl = *max_element(nums.begin(), nums.end());
        
        int dp[n + 1][maxEl + 1][maxEl + 1];

        // base case
        for(int gcd_1 = 0; gcd_1 <= maxEl; gcd_1++) {
            for(int gcd_2 = 0; gcd_2 <= maxEl; gcd_2++) {
                bool bothNonEmpty = (gcd_1 != 0 && gcd_2 != 0);
                bool gcdMatches   = (gcd_1 == gcd_2);
                 
                dp[n][gcd_1][gcd_2] = (bothNonEmpty && gcdMatches) ? 1 : 0;
            }
        }

        // fill rest of dp

        for(int i = n - 1; i >= 0; i--) {
            for(int gcd_1 = maxEl; gcd_1 >= 0; gcd_1--) {
                for(int gcd_2 = maxEl; gcd_2 >= 0; gcd_2--) {

                    // skip the element
                    int skip = (dp[i + 1][gcd_1][gcd_2]) % M;

                    // take in subsequence 1
                    int take_1 = (dp[i + 1][gcd(gcd_1, nums[i])][gcd_2]) % M;
                    
                    // take in subsequence 2
                    int take_2 = (dp[i + 1][gcd_1][gcd(gcd_2, nums[i])]) % M;

                    dp[i][gcd_1][gcd_2] = (0LL + skip + take_1 + take_2) % M;
                }
            }
        }

        return dp[0][0][0];
    }
};


// Appraoch 3 : Improved Bottom Up

class Solution {
public:
    int M = 1e9 + 7;

    int subsequencePairCount(vector<int>& nums) {
        int n = nums.size();
        int maxEl = *max_element(nums.begin(), nums.end());
        
        vector<vector<int>> prev(maxEl + 1, vector<int>(maxEl + 1));

        // base case
        for(int gcd_1 = 0; gcd_1 <= maxEl; gcd_1++) {
            for(int gcd_2 = 0; gcd_2 <= maxEl; gcd_2++) {
                bool bothNonEmpty = (gcd_1 != 0 && gcd_2 != 0);
                bool gcdMatches   = (gcd_1 == gcd_2);
                 
                prev[gcd_1][gcd_2] = (bothNonEmpty && gcdMatches) ? 1 : 0;
            }
        }

        // fill rest of dp

        for(int i = n - 1; i >= 0; i--) {
            vector<vector<int>> curr(maxEl + 1, vector<int>(maxEl + 1));
            for(int gcd_1 = maxEl; gcd_1 >= 0; gcd_1--) {
                for(int gcd_2 = maxEl; gcd_2 >= 0; gcd_2--) {

                    // skip the element
                    int skip = (prev[gcd_1][gcd_2]) % M;

                    // take in subsequence 1
                    int take_1 = (prev[gcd(gcd_1, nums[i])][gcd_2]) % M;
                    
                    // take in subsequence 2
                    int take_2 = (prev[gcd_1][gcd(gcd_2, nums[i])]) % M;

                    curr[gcd_1][gcd_2] = (0LL + skip + take_1 + take_2) % M;
                }
            }

            prev = move(curr);
        }

        return prev[0][0];
    }
};
