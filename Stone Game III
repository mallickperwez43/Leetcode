// Recursion + Memoization

class Solution {
public:
    int n;
    
    int solve(int i, vector<int>& stones, vector<int>& dp) {
        if(i >= n) 
            return 0;
        
        if(dp[i] != -1) {
            return dp[i];
        }

        int result = stones[i] - solve(i + 1, stones, dp);

        if(i + 1 < n) {
            result = max(result, stones[i] + stones[i + 1] - solve(i + 2, stones, dp));
        }

        if(i + 2 < n) {
            result = max(result, stones[i] + stones[i + 1] + stones[i + 2] - solve(i + 3, stones, dp));
        }

        return dp[i] = result;
    }

    string stoneGameIII(vector<int>& stones) {
        n = stones.size();

        vector<int> dp(n + 1, -1);

        int diff = solve(0, stones, dp);

        if(diff < 0) 
            return "Bob";
        else if(diff > 0) 
            return "Alice";
        else
            return "Tie";
    }
};


// Bottom Up

class Solution {
public:
    string stoneGameIII(vector<int>& stones) {
        int n = stones.size();

        vector<int> dp(n + 1, 0);

        for(int i = n - 1; i >= 0; i--) {

            dp[i] = stones[i] - dp[i + 1];

            if(i + 2 <= n) {
                dp[i] = max(dp[i], stones[i] + stones[i + 1] - dp[i + 2]);
            }

            if(i + 3 <= n) {
                dp[i] = max(dp[i], stones[i] + stones[i + 1] + stones[i + 2] - dp[i + 3]);
            }
        }

        int diff = dp[0];

        if(diff < 0) 
            return "Bob";
        else if(diff > 0) 
            return "Alice";
        else
            return "Tie";
    }
};


// Bottom Up : Space Optimised

class Solution {
public:
    string stoneGameIII(vector<int>& stones) {
        int n = stones.size();

        // vector<int> dp(n + 1, 0);
        int a = 0; // dp[i + 1];
        int b = 0; // dp[i + 2];
        int c = 0; // dp[i + 3];

        for(int i = n - 1; i >= 0; i--) {

            int result = INT_MIN;

            result = max(result, stones[i] - a);

            if(i + 2 <= n) {
                result = max(result, stones[i] + stones[i + 1] - b);
            }

            if(i + 3 <= n) {
                result = max(result, stones[i] + stones[i + 1] + stones[i + 2] - c);
            }

            c = b;
            b = a;
            a = result;
        }

        int diff = a;

        if(diff < 0) 
            return "Bob";
        else if(diff > 0) 
            return "Alice";
        else
            return "Tie";
    }
};
