class Solution {
public:
    vector<int> maxDepthAfterSplit(string seq) {
        int n = seq.length();

        vector<int> result(n);
        int depth = 0;

        for(int i = 0; i < n; i++) {
            if(seq[i] == '(') {
                depth++;
                result[i] = (depth & 1) ? 1 : 0;
            }
            else {
                result[i] = (depth & 1) ? 1 : 0;
                depth--;
            }
        }

        return result;
    }
};
