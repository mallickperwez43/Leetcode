// Approach 1

class Solution {
public:
    int n;
    
    bool isPalindrome(string& s, int i, int j) {
        while(i < j) {
            if(s[i] != s[j]) 
                return false;
    
            i++;
            j--;
        }

        return true;
    }

    int solve(string& s, int k, int i, int j, vector<vector<int>>& dp) {
        if(i >= n || j >= n)
            return 0;

        if(dp[i][j] != -1) {
            return dp[i][j];
        }

        if(isPalindrome(s, i, j)) {
            int takeIt = 1 + solve(s, k, j + 1, j + k, dp);
            int grow   = solve(s, k, i, j + 1, dp);
            int slide  = solve(s, k, i + 1, j + 1, dp);

            return dp[i][j] = max({takeIt, grow, slide});
        }

        int grow  = solve(s, k, i, j + 1, dp);
        int slide = solve(s, k, i + 1, j + 1, dp);

        return dp[i][j] = max(grow, slide);
    }

    int maxPalindromes(string s, int k) {
        n = s.length();

        if(k == 1)
            return n; // max palindrome 

        vector<vector<int>> dp(n + 1, vector<int>(n + 1, -1));

        return solve(s, k, 0, k - 1, dp);
    }
};

// TC : O(n ^ 2 * n) ~ O(n ^ 3)
// SC : O(n ^ 2)


// Approach 2

class Solution {
public:
    int n;
    
    bool isPalindrome(string& s, int i, int j) {
        while(i < j) {
            if(s[i] != s[j]) 
                return false;
    
            i++;
            j--;
        }

        return true;
    }

    int maxPalindromes(string s, int k) {
        int n = s.length();

        if(k == 1)
            return n; // max palindrome 

        vector<vector<int>> dp(n + 1, vector<int>(n + 1));

        for(int i = n - 1; i >= 0; i--) {
            for(int j = n - 1; j >= 0; j--) {
                if(isPalindrome(s, i, j)) {
                    int takeIt = 1 + (j + k <= n ? dp[j + 1][j + k] : 0); // 1 + solve(s, k, j + 1, j + k, dp);
                    int grow   = dp[i][j + 1]; // solve(s, k, i, j + 1, dp);
                    int slide  = dp[i + 1][j + 1]; // solve(s, k, i + 1, j + 1, dp);

                    dp[i][j] = max({takeIt, grow, slide});
                }

                int grow  = dp[i][j + 1]; // solve(s, k, i, j + 1, dp);
                int slide = dp[i + 1][j + 1]; // solve(s, k, i + 1, j + 1, dp);

                dp[i][j] = max({dp[i][j], grow, slide});
            }
        }

        return dp[0][k - 1]; // solve(s, k, 0, k - 1, dp);
    }
};

// TC : O(n ^ 2 * n) ~ O(n ^ 3)
// SC : O(n ^ 2)


// Approach 3

class Solution {
public:
    int n;
    
    vector<vector<bool>> isPalindrome;

    int solve(string& s, int k, int i, int j, vector<vector<int>>& dp) {
        if(i >= n || j >= n)
            return 0;

        if(dp[i][j] != -1) {
            return dp[i][j];
        }

        if(isPalindrome[i][j]) { // isPalindrome(s, i, j)
            int takeIt = 1 + solve(s, k, j + 1, j + k, dp);
            int grow   = solve(s, k, i, j + 1, dp);
            int slide  = solve(s, k, i + 1, j + 1, dp);

            return dp[i][j] = max({takeIt, grow, slide});
        }

        int grow  = solve(s, k, i, j + 1, dp);
        int slide = solve(s, k, i + 1, j + 1, dp);

        return dp[i][j] = max(grow, slide);
    }

    int maxPalindromes(string s, int k) {
        n = s.length();

        if(k == 1)
            return n; // max palindrome 
        
        isPalindrome.assign(n + 1, vector<bool>(n + 1, false));
        // BluePrint
        for(int L = 1; L <= n; L++) {
            for(int i = 0; i + L <= n; i++) {
                int j = i + L - 1;

                if(i == j) { // 1 Length always a Palindrome
                    isPalindrome[i][j] = true;
                }
                else if(i + 1 == j) { // 2 Length -> s[i] == s[j]
                    isPalindrome[i][j] = (s[i] == s[j]);
                }
                else { // L >= 3 s[i] == s[j] && internal -> [i + 1][j - 1] -> isPalindrome
                    isPalindrome[i][j] = ((s[i] == s[j]) && isPalindrome[i + 1][j - 1]);
                }
            }
        }

        vector<vector<int>> dp(n + 1, vector<int>(n + 1, -1));

        return solve(s, k, 0, k - 1, dp);
    }
};

// TC : O(n ^ 2 * 1) ~ O(n ^ 2)
// SC : O(n ^ 2)


