class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int minEl = *min_element(nums1.begin(), nums1.end());

        if(minEl & 1) { // odd -> we can convert all even to odd
            return true; // nums2 -> all odd
        }

        // check if we can make all even in nums2 
        for(int& num : nums1) {
            if(num & 1) {
                return false;
            }
        }

        return true; // all nums2 -> even
    }
};
