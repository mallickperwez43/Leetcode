class Solution {
public:
    int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }

        return a;
    }

    int findGCD(vector<int>& nums) {
        int maxEl = INT_MIN;
        int minEl = INT_MAX;

        for(int& el : nums) {
            maxEl = max(maxEl, el);
            minEl = min(minEl, el);
        }

        return gcd(minEl, maxEl);
    }
};
