// Approach 1 : Recursion + Memoization

class Solution {
public:
    typedef unsigned long long ll;

    ll solve(string& s, string& t, int m, int n, vector<vector<ll>>& dp) {
        if(n == 0) return dp[m][n] = 1; // found one subsequence
        if(m == 0) return dp[m][n] = 0; // found no subsequence

        if(dp[m][n] != -1) {
            return dp[m][n];
        }

        if(s[m - 1] == t[n - 1]) {
            return dp[m][n] = solve(s, t, m - 1, n - 1, dp) + solve(s, t, m - 1, n, dp);
        }
        else {
            return dp[m][n] = solve(s, t, m - 1, n, dp);
        }

        return -1;
    }

    int numDistinct(string s, string t) {
        int m = s.length();
        int n = t.length();

        vector<vector<ll>> dp(m + 1, vector<ll>(n + 1, -1));

        return solve(s, t, m, n, dp);
    }
};


// Approach 2 : Bottom Up

class Solution {
public:
    typedef unsigned long long ll;

    int numDistinct(string s, string t) {
        int m = s.length();
        int n = t.length();

        vector<vector<ll>> dp(m + 1, vector<ll>(n + 1));

        // Base case 1
        // if(n == 0) return 1;
        for(int i = 0; i <= m; i++) {
            dp[i][0] = 1;
        }
        // if(m == 0) return 0;
        for(int i = 1; i <= n; i++) {
            dp[0][i] = 0;
        }

        for(int i = 1; i <= m; i++) {
            for(int j = 1; j <=n; j++) {
                if(s[i - 1] == t[j - 1]) {
                    dp[i][j] = dp[i - 1][j - 1] + dp[i - 1][j];
                }
                else {
                    dp[i][j] = dp[i - 1][j];
                }
            }
        }

        return dp[m][n];
    }
};


// Approach 3 : Space Optimised Bottom Up

class Solution {
public:
    typedef unsigned long long ll;

    int numDistinct(string s, string t) {
        int m = s.length();
        int n = t.length();

        // vector<vector<ll>> dp(m + 1, vector<ll>(n + 1));
        vector<ll> prev(n + 1, 0);
        vector<ll> curr(n + 1, 0);

        prev[0] = 1;
        curr[0] = 1;

        for(int i = 1; i <= m; i++) {
            for(int j = 1; j <=n; j++) {
                if(s[i - 1] == t[j - 1]) {
                    curr[j] = prev[j - 1] + prev[j];
                }
                else {
                    curr[j] = prev[j];
                }
            }

            prev = curr;
        }

        return prev[n];
    }
};
