// Approach 1 (Super Brute Force) - TLE

class Solution {
public:
    int solve(int i, int j, vector<int>& nums, int k) {
        long long product = 1;
        for (int t = i; t <= j; t++) {
            product = (product * nums[t]) % k;
        }
        return (int)product;
    }

    vector<long long> resultArray(vector<int>& nums, int k) {
        int n = nums.size();
        vector<long long> result(k, 0);

        for (int i = 0; i < n; i++) {
            for (int j = i; j < n; j++) {
                int x = solve(i, j, nums, k);
                result[x]++;
            }
        }

        return result;
    }
};
//T.C : O(n^3)
//S.C : O(1)
