class Solution {
public:
    typedef long long ll;

    int maximumLength(vector<int>& nums) {
        unordered_map<ll, int> mp;
        for(int& num : nums) {
            mp[num]++;
        }

        int result = 0;

        // base case of 1
        if(mp[1] & 1) {
            result = mp[1];
        }
        else { // even
            result = mp[1] - 1;
        }

        for(auto& [num, freq] : mp) {
            if(num == 1) continue;

            ll curr = num;
            int len = 0;

            while(mp.count(curr) && mp[curr] > 1) {
                len += 2;
                curr *= curr;
            }

            if(mp.count(curr) == 1) { // peak
                len += 1;
            } 
            else { // no peak, so take the prev max only once
                len -= 1;
            }

            result = max(result, len);
        }

        return result;
    }
};
