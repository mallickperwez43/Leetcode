class Solution {
public:
    int missingMultiple(vector<int>& nums, int k) {
        vector<bool> present(101, false);

        for(int& num : nums) {
            present[num] = true;
        }   

        int multiple = k;
        while(multiple <= 100 && present[multiple]) {
            multiple += k;
        }

        return multiple;
    }
};
