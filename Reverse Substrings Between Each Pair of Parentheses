// Brute Force

class Solution {
public:
    string reverseParentheses(string s) {
        stack<int> lastSkipLength;

        string result;

        for(char& ch : s) {
            if(ch == '(') {
                lastSkipLength.push(result.length());
            }
            else if(ch == ')') {
                int l = lastSkipLength.top();
                lastSkipLength.pop();
                reverse(result.begin() + l, result.end());
            }
            else {
                result.push_back(ch);
            }
        }

        return result;
    }
};

// TC : O(n ^ 2)
// SC : O(n)


// Warmhole Teleportation

class Solution {
public:
    string reverseParentheses(string s) {
        int n = s.length();

        stack<int> openBracketIdx;
        vector<int> door(n);
        // door[i] = j; i -> j teleport

        for(int i = 0; i < n; i++) {
            if(s[i] == '(') {
                openBracketIdx.push(i);
            }
            else if (s[i] == ')') {
                int j = openBracketIdx.top();
                openBracketIdx.pop();

                door[i] = j;
                door[j] = i;
            }
        }

        string result;
        int flag = 1;
        for(int i = 0; i < n; i += flag) {
            if(s[i] == '(' || s[i] == ')') {
                i = door[i];
                flag *= -1;
            }
            else {
                result.push_back(s[i]);
            }
        }

        return result;
    }
};

// TC : O(n)
// SC : O(n)
